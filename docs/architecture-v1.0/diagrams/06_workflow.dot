digraph G { graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.2, ranksep=0.36, fontname="DejaVu Sans"]; node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#225278", fillcolor="#EAF2FA", margin="0.14,0.08"]; edge [fontsize=9, fontname="DejaVu Sans", arrowsize=0.55, color="#47769E"]; S1[label="01 Tiếp nhận hồ sơ đầu vào"]; G1[label="Đủ & được duyệt?",shape=diamond,fillcolor="#FFF2DE"]; S2[label="02 Xử lý hồ sơ trường"]; G2[label="Kiểm tra chéo đạt?",shape=diamond,fillcolor="#FFF2DE"]; S3[label="03 Nộp hồ sơ trường"]; H[label="Bàn giao Đối ngoại",fillcolor="#DCECE6"]; SEND[label="Gửi trường",fillcolor="#DCECE6"]; REC[label="Trường xác nhận nhận",fillcolor="#DCECE6"]; S4[label="04 Phỏng vấn trường"]; S5[label="05 Hồ sơ lãnh sự"]; S6[label="06 Nộp Visa"]; S7[label="07 Xuất cảnh & bàn giao"]; DONE[label="Hoàn tất theo bằng chứng",fillcolor="#DCECE6"]; WAIT[label="Bổ sung / theo dõi",fillcolor="#FFF2DE"]; S1->G1;G1->S2[label="Đạt"];G1->WAIT[label="Thiếu"];WAIT->S1;S2->G2;G2->S3[label="Đạt"];G2->S2[label="Chưa"];S3->H->SEND->REC->S4->S5->S6->S7->DONE;}
